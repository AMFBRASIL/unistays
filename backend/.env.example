# Copie para .env e ajuste

# --- Efí Pay (Gerencianet) — PIX (opcional; usado pelo PaymentService e web check-in) ---
# Documentação: https://dev.efipay.com.br/
EFI_GN_ENABLED=false
# true = homologação; false = produção
EFI_GN_SANDBOX=true
EFI_GN_CLIENT_ID=
EFI_GN_CLIENT_SECRET=
# Chave PIX vinculada à conta Efí
EFI_GN_PIX_KEY=
# Caminho do certificado .p12 (relativo à pasta backend ou absoluto), OU use BASE64 abaixo
EFI_GN_CERTIFICATE_PATH=
# Certificado .p12 em uma linha Base64 (alternativa ao arquivo — útil em PaaS)
EFI_GN_CERTIFICATE_BASE64=
# Tempo de expiração da cobrança imediata (segundos)
# --- Channex Channel Manager (PMS ↔ OTAs) ---
# Docs: https://docs.channex.io/
# Staging: https://staging.channex.io/ — API Key no perfil do usuário
# OBRIGATÓRIO para webhooks: URL pública HTTPS do backend (produção ou tunnel ngrok/cloudflared).
# Sem isso a Channex não consegue notificar reservas no Unistays local.
# Ex. local: API_PUBLIC_URL=https://xxxx.ngrok-free.app
# Ex. prod:  API_PUBLIC_URL=https://api.unistays.com.br
API_PUBLIC_URL=http://localhost:3020
# Poller do booking feed (ms). Default 60000. Com webhook, 15min também serve; feed-only prefira 60s.
# CHANNEX_FEED_POLL_MS=60000
