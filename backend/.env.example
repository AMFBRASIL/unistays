# Copie para .env e ajuste (nunca commitar o .env real)

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=unistays

# --- JWT (obrigatório em produção — valores longos e aleatórios) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Senha para autorizar desconto acima de 5% nas reservas ---
RESERVATION_DISCOUNT_AUTH_PASSWORD=

# --- Servidor ---
NODE_ENV=development
PORT=3020
API_PUBLIC_URL=http://localhost:3020
FRONTEND_PUBLIC_URL=http://localhost:5173

# --- Efí Pay (Gerencianet) — PIX (opcional) ---
# Documentação: https://dev.efipay.com.br/
EFI_GN_ENABLED=false
EFI_GN_SANDBOX=true
EFI_GN_CLIENT_ID=
EFI_GN_CLIENT_SECRET=
EFI_GN_PIX_KEY=
EFI_GN_CERTIFICATE_PATH=
EFI_GN_CERTIFICATE_BASE64=

# --- Channex Channel Manager (PMS ↔ OTAs) ---
# Docs: https://docs.channex.io/
# CHANNEX_FEED_POLL_MS=60000

# --- E-mail (opcional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@seudominio.com
