# Copie para .env e ajuste

# --- Efí Pay (Gerencianet) — PIX (opcional; usado pelo PaymentService e web check-in) ---
# Documentação: https://dev.efipay.com.br/
EFI_GN_ENABLED=false
# true = homologação; false = produção
EFI_GN_SANDBOX=true
EFI_GN_CLIENT_ID=
EFI_GN_CLIENT_SECRET=
# Chave PIX vinculada à conta Efí
EFI_GN_PIX_KEY=
# Caminho do certificado .p12 (relativo à pasta backend ou absoluto), OU use BASE64 abaixo
EFI_GN_CERTIFICATE_PATH=
# Certificado .p12 em uma linha Base64 (alternativa ao arquivo — útil em PaaS)
EFI_GN_CERTIFICATE_BASE64=
# Tempo de expiração da cobrança imediata (segundos)
EFI_GN_CHARGE_EXPIRATION_SECONDS=3600
